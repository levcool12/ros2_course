<?xml version="1.0"?>
<!--
  PR07: minimal "city" world (reconstruction - the official course kit
  world was unavailable). The <include> spawns exactly one robot via
  model://course_ackermann, so the workspace must export
  GZ_SIM_RESOURCE_PATH to src/course_simulation/models.
  Launch headless: gz sim -s -r --headless-rendering mcity-minimal.sdf
-->
<sdf version="1.8">
  <world name="mcity_minimal">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors (camera, gpu_lidar) need the sensors system + ogre2. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Non-rendering sensors (IMU) need their own system plugin. -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.35 1</ambient>
            <diffuse>0.3 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A few static "city blocks" for the lidar to see. -->
    <model name="block_a">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 6 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 6 2</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="block_b">
      <static>true</static>
      <pose>10 -6 1.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 3</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="block_c">
      <static>true</static>
      <pose>3.5 7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.3 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Exactly one robot, spawned by the world itself. -->
    <include>
      <uri>model://course_ackermann</uri>
      <pose>0 0 0.12 0 0 0</pose>
    </include>
  </world>
</sdf>
